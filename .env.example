INSTAGRAM_USERNAME=zero2sudo
# Comma-separated providers run together on every poll, so one going down does not
# stop detection. Known: igexport, instagram_bio.
STORY_PROVIDER=igexport,instagram_bio

# How often the instagram_bio source may call Instagram directly. Keep this well above
# POLL_INTERVAL_SECONDS. 600s attracted a 401 throttle on 2026-08-11; 3600s is the new floor.
BIO_POLL_INTERVAL_SECONDS=3600
POLL_INTERVAL_SECONDS=60

# Overnight the account does not post. Across 96 Stories in two samples a month apart
# (2026-08-09..11 and 2026-09-02..03) not one fell between 23:00 and 06:00 Pacific, so
# those hours poll on a much slower cadence — about 27% fewer requests a day for no
# measurable latency cost.
#
# The window is wall-clock in a named timezone, so it follows daylight saving on its
# own. An unknown timezone disables the window and everything polls at the normal
# interval; polling too often wastes a request, polling too rarely misses a posting.
# Set QUIET_HOUR_START == QUIET_HOUR_END to turn the feature off.
POLL_TIMEZONE=America/Los_Angeles
QUIET_HOUR_START=23
QUIET_HOUR_END=6
QUIET_POLL_INTERVAL_SECONDS=800
PROCESS_EXISTING_STORIES_ON_STARTUP=false
DATABASE_PATH=./data/job_monitor.db

# Set only on hosts with an ephemeral filesystem (Render). Takes precedence over
# DATABASE_PATH and switches the storage backend to PostgreSQL.
DATABASE_URL=

# Confirmed entry-level and new-grad roles.
DISCORD_NEW_GRAD_WEBHOOK_URL=

# Internships are posted here instead. Falls back to DISCORD_NEW_GRAD_WEBHOOK_URL when
# unset, so leaving it blank mixes internships into the main channel rather than
# dropping them.
DISCORD_INTERNSHIP_WEBHOOK_URL=

# Everything that is not a confirmed match: near misses, plain rejections, and pages
# the fetcher could not read at all. A review channel, not an alert channel — no
# mention is ever attached. Leave blank to drop them silently.
DISCORD_REVIEW_WEBHOOK_URL=

# Last-resort fetch for pages that block plain HTTP clients (AWS WAF and similar).
# `{url}` is replaced with the target. Only used when JSON-LD, page metadata and the URL
# slug have all failed, so the common path never touches it. Set empty to disable.
RENDER_PROXY_URL=https://r.jina.ai/{url}

# Confidence a classification must reach before it routes anywhere but the review
# channel. These are bounded scores, not calibrated probabilities — tune them against
# observed classifications rather than deriving them. Raise to send more to review.
ROLE_CONFIDENCE_THRESHOLD=0.60
EMPLOYMENT_CONFIDENCE_THRESHOLD=0.55

# Added to both thresholds when the fetcher recovered little text (a URL slug or bare
# page metadata rather than JSON-LD or a rendered page). Scoring nine words off a URL
# path as confidently as a full description is overconfidence, not skill.
POOR_INPUT_CONFIDENCE_PENALTY=0.15

# Raw Discord mention text prepended to each alert so it actually pings. Use role IDs:
#   DISCORD_NEW_GRAD_MENTIONS=<@&987654321>
# Enable Discord's Developer Mode, then right-click a role and Copy ID. Independent per
# role type on purpose — they do not fall back to each other.
DISCORD_NEW_GRAD_MENTIONS=
DISCORD_INTERNSHIP_MENTIONS=

# Optional. A healthchecks.io-style ping URL, hit after every poll. If the pings stop,
# the external monitor alerts you — otherwise a dead tracker looks like a quiet account.
HEARTBEAT_URL=

# Renamed on 2026-08-24. The old names below still work and take effect only when the
# new name above is unset, so an environment can be migrated without downtime. They warn
# at startup and will be removed.
#   DISCORD_WEBHOOK_URL          -> DISCORD_NEW_GRAD_WEBHOOK_URL
#   DISCORD_MENTIONS             -> DISCORD_NEW_GRAD_MENTIONS
#   DISCORD_UNKNOWN_WEBHOOK_URL  -> DISCORD_REVIEW_WEBHOOK_URL
