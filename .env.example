INSTAGRAM_USERNAME=zero2sudo
# Comma-separated providers run together on every poll, so one going down does not
# stop detection. Known: igexport, instagram_bio.
STORY_PROVIDER=igexport,instagram_bio

# How often the instagram_bio source may call Instagram directly. Keep this well above
# POLL_INTERVAL_SECONDS — a residential IP polling Instagram every minute invites a block.
BIO_POLL_INTERVAL_SECONDS=600
POLL_INTERVAL_SECONDS=60
PROCESS_EXISTING_STORIES_ON_STARTUP=false
DATABASE_PATH=./data/job_monitor.db
DISCORD_WEBHOOK_URL=

# Optional. A healthchecks.io-style ping URL, hit after every poll. If the pings stop,
# the external monitor alerts you — otherwise a dead tracker looks like a quiet account.
HEARTBEAT_URL=
